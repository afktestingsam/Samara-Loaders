Defer(function()
    do
        local connections = {}
        local coinOriginals = setmetatable({}, {__mode = "k"})
        local physicsOriginals = setmetatable({}, {__mode = "k"})
        local character, root, trackerPart
        local rootMass = 0
        local lastUpdate = 0
        local WATER_JUMP_FORCE = 167
        local TRACKER_NAME = "N4T_Douglas_TrackerPart"
        local function disconnectAll()
            for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
            table.clear(connections)
        end
        local function rememberAndDisableTouch(part)
            if not part:IsA("BasePart") then return end
            if coinOriginals[part] == nil then coinOriginals[part] = part.CanTouch end
            part.CanTouch = false
        end
        local function handleAntiCoin(object)
            if not states["SPEED DOUGLAS"] or not object then return end
            pcall(function()
                local isCoin = object.Name == "Coin" or object.Name == "CoinContainer" or object:FindFirstChild("CoinVisual") ~= nil
                if not isCoin then return end
                if object:IsA("BasePart") then rememberAndDisableTouch(object) end
                for _, child in ipairs(object:GetDescendants()) do
                    if child:IsA("BasePart") then rememberAndDisableTouch(child) end
                end
            end)
        end
        local function getAveragePosition(char)
            local sum = Vector3.new(0,0,0)
            local count = 0
            for _, obj in ipairs(char:GetDescendants()) do
                if obj:IsA("BasePart") and not obj.Anchored and obj.Name ~= TRACKER_NAME and not obj:FindFirstAncestorOfClass("Tool") then
                    sum = sum + obj.Position; count = count + 1
                end
            end
            if count == 0 then return root and root.Position or Vector3.new() end
            return sum / count
        end
        local function zeroOutCharacterMass()
            if not character then return end
            for _, obj in ipairs(character:GetDescendants()) do
                if obj:IsA("BasePart") and obj ~= trackerPart and not obj:FindFirstAncestorOfClass("Tool") then
                    if physicsOriginals[obj] == nil then physicsOriginals[obj] = obj.CustomPhysicalProperties or false end
                    obj.CustomPhysicalProperties = PhysicalProperties.new(0.2, 0.3, 0.5, 1, 1)
                end
            end
        end
        local function waitForMass(part)
            local count = 0
            while states["SPEED DOUGLAS"] and part and part.Parent and part.AssemblyMass < 0.01 and count < 40 do
                task.wait(0.1); count = count + 1
            end
            return (part and part.Parent) and part.AssemblyMass or 0
        end
        local function removeTracker()
            if trackerPart then pcall(function() trackerPart:Destroy() end) end
            trackerPart = nil
            if character then
                local old = character:FindFirstChild(TRACKER_NAME)
                if old then pcall(function() old:Destroy() end) end
            end
        end
        local function updateTracker()
            if not states["SPEED DOUGLAS"] or not character or not root or not root.Parent then return end
            if not trackerPart or not trackerPart.Parent then
                trackerPart = Instance.new("Part")
                trackerPart.Name = TRACKER_NAME; trackerPart.Size = Vector3.new(2,2,2)
                trackerPart.Transparency = 1; trackerPart.CanCollide = false
                trackerPart.CanTouch = false; trackerPart.CanQuery = false
                trackerPart.Anchored = false; trackerPart.Parent = character
                local w = Instance.new("WeldConstraint")
                w.Part0 = trackerPart; w.Part1 = root; w.Parent = trackerPart
            end
            local avgPos = getAveragePosition(character)
            trackerPart.Position = avgPos + (avgPos - root.Position) * 0.35
            zeroOutCharacterMass()
            local volume = trackerPart.Size.X * trackerPart.Size.Y * trackerPart.Size.Z
            local density = math.clamp((volume > 0 and rootMass / volume or 1), 0.1, 35)
            trackerPart.CustomPhysicalProperties = PhysicalProperties.new(density, 0.3, 0.5, 1, 1)
        end
        local function safeUpdate()
            if not states["SPEED DOUGLAS"] then return end
            local now = tick()
            if now - lastUpdate < 0.2 then return end
            lastUpdate = now
            task.defer(updateTracker)
        end
        local function onCharacter(char)
            if not states["SPEED DOUGLAS"] then return end
            character = char; removeTracker()
            local humanoid = char:WaitForChild("Humanoid", 5)
            local newRoot = char:WaitForChild("HumanoidRootPart", 5)
            if not humanoid or not newRoot then return end
            root = newRoot
            local swimming = false
            table.insert(connections, humanoid.StateChanged:Connect(function(oldState, newState)
                if not states["SPEED DOUGLAS"] or not char.Parent then return end
                swimming = newState == Enum.HumanoidStateType.Swimming
                if oldState == Enum.HumanoidStateType.Swimming and newState == Enum.HumanoidStateType.Jumping then
                    pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Freefall) end)
                end
            end))
            table.insert(connections, UserInputService.JumpRequest:Connect(function()
                if not states["SPEED DOUGLAS"] or not char.Parent then return end
                pcall(function()
                    if swimming and root and root.Parent then
                        local v = root.AssemblyLinearVelocity
                        root.AssemblyLinearVelocity = Vector3.new(v.X, WATER_JUMP_FORCE, v.Z)
                    end
                end)
            end))
            task.delay(1, function()
                if not states["SPEED DOUGLAS"] or character ~= char or not root or not root.Parent then return end
                rootMass = waitForMass(root)
                pcall(updateTracker)
            end)
            table.insert(connections, char.DescendantAdded:Connect(function(obj) if not obj:FindFirstAncestorOfClass("Tool") then safeUpdate() end end))
            table.insert(connections, char.DescendantRemoving:Connect(function(obj) if not obj:FindFirstAncestorOfClass("Tool") then safeUpdate() end end))
        end
        function NewFeatures.speedDouglasOff()
            states["SPEED DOUGLAS"] = false
            disconnectAll(); removeTracker()
            character = nil; root = nil
        end
        function NewFeatures.speedDouglasOn()
            NewFeatures.speedDouglasOff()
            states["SPEED DOUGLAS"] = true
            for _, desc in ipairs(Workspace:GetDescendants()) do handleAntiCoin(desc) end
            table.insert(connections, Workspace.DescendantAdded:Connect(handleAntiCoin))
            if player.Character then task.spawn(onCharacter, player.Character) end
            table.insert(connections, player.CharacterAdded:Connect(function(char) task.wait(0.15); onCharacter(char) end))
        end
    end
    CreateToggle(MainScriptTab, "SPEED DOUGLAS", function(state)
        if state then NewFeatures.speedDouglasOn() else NewFeatures.speedDouglasOff() end
    end, 6)
end)

