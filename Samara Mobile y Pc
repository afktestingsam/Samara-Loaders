local function Defer(fn) task.defer(function() pcall(fn) end) end
local function batchScan(container, callback, batchSize)
    batchSize = batchSize or 250
    local list = container:GetDescendants()
    for i = 1, #list, batchSize do
        local stop = math.min(i + batchSize - 1, #list)
        for j = i, stop do pcall(callback, list[j]) end
        task.wait()
    end
end

