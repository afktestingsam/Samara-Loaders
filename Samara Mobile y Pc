local function playSound(soundId, volume)
    local s = Instance.new("Sound")
    s.SoundId = "rbxassetid://" .. soundId
    s.Volume = volume or 1
    s.Parent = SoundService
    s:Play()
    Debris:AddItem(s, 3)
end

local lastPlayUI = 0
local function playUISound()
    local now = tick()
    if now - lastPlayUI < 0.03 then return end
    lastPlayUI = now
    playSound(UI_SOUND_ID, 1)
end

local function hookUIButton(v)
    if not v:IsA("GuiButton") then return end
    if v:GetAttribute("N4T_Snd") then return end
    v:SetAttribute("N4T_Snd", true)
    v.Activated:Connect(playUISound)
    v.MouseButton1Click:Connect(playUISound)
end

local function hookContainer(container)
    if not container then return end
    for _, v in ipairs(container:GetDescendants()) do hookUIButton(v) end
    container.DescendantAdded:Connect(hookUIButton)
end

