    for _, v in ipairs(container:GetDescendants()) do hookUIButton(v) end
    container.DescendantAdded:Connect(hookUIButton)
end

local _origCreateToggle = CreateToggle
local _pendingStarSearches = {}
local _starProcessorRunning = false
CreateToggle = function(parent, name, callback, order)
    local star = nil
    local wrappedCallback = function(state)
        if star then star.Image = state and FAV_ICON_ON or FAV_ICON_OFF end
        pcall(callback, state)
    end
    local result = _origCreateToggle(parent, name, wrappedCallback, order)
    table.insert(_pendingStarSearches, {
        parent = parent, name = name,
        setStar = function(s) star = s end,
    })
    if not _starProcessorRunning then
        _starProcessorRunning = true
        task.spawn(function()
            task.wait(0.4)
            local function findToggleUI(container, targetName, depth)
                depth = depth or 0
                if depth > 6 or not container then return nil end
                for _, child in ipairs(container:GetChildren()) do
                    if child:IsA("GuiObject") then
                        for _, dc in ipairs(child:GetChildren()) do
                            if dc:IsA("TextLabel") and dc.Text == targetName then return child end
                        end
                        local found = findToggleUI(child, targetName, depth + 1)
                        if found then return found end
                    end
                end
                return nil
            end
            for i, item in ipairs(_pendingStarSearches) do
                pcall(function()
                    local toggleFrame = findToggleUI(item.parent, item.name)
                    if not toggleFrame or toggleFrame:FindFirstChild("N4T_FavStar") then return end
                    local s = Instance.new("ImageLabel")
                    s.Name = "N4T_FavStar"
                    s.Size = UDim2.fromOffset(18, 18)
                    s.Position = UDim2.new(1, -45, 0.5, -9)
                    s.BackgroundTransparency = 1
                    s.Image = FAV_ICON_OFF
                    s.ZIndex = 20
                    s.Parent = toggleFrame
                    item.setStar(s)
                end)
                if i % 5 == 0 then task.wait(0.03) end
            end
            _pendingStarSearches = {}
            _starProcessorRunning = false
        end)
    end
    return result
end

