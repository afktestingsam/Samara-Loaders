local function tween(obj, info, props)
	local t = TweenService:Create(obj, info, props)
	t:Play()
	return t
end

local function wiggleIcon()
	for _, angle in ipairs({-12, 12, -8, 8, 0}) do
		tween(icon, TweenInfo.new(0.1, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Rotation = angle})
		task.wait(0.1)
	end
end

local function run()
	mainFrame.GroupTransparency = 1
	mainFrame.Position = UDim2.new(0.5, 0, 0.5, 36)
	mainFrame.Rotation = -4
	mainScale.Scale = baseScale * 0.7

	local tIn = 0.7
	tween(mainFrame, TweenInfo.new(tIn, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = CENTER})
	tween(mainFrame, TweenInfo.new(tIn, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Rotation = 0})
	tween(mainScale, TweenInfo.new(tIn, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = baseScale})
	tween(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {GroupTransparency = 0})
	task.wait(0.45)

	if SHOW_WARNING_ICON then
		task.spawn(wiggleIcon)
	end
	local target = getPercent()
	local fillInfo = TweenInfo.new(1.8, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	tween(progress, fillInfo, {Value = target})
	task.wait(tIn - 0.45)

	local t0 = os.clock()
	while os.clock() - t0 < DISPLAY_SECONDS and not closing do
		task.wait(0.25)
		local p = getPercent()
		if math.abs(p - target) >= 0.5 then
			target = p
			tween(progress, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Value = p})
		end
	end

	local tOut = 0.5
	tween(mainScale, TweenInfo.new(tOut, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = baseScale * 0.85})
	tween(mainFrame, TweenInfo.new(tOut, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {Position = UDim2.new(0.5, 0, 0.5, -30)})
	tween(mainFrame, TweenInfo.new(0.42, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {GroupTransparency = 1})
	task.wait(tOut + 0.05)
end

task.spawn(function()
	local ok, err = pcall(run)
	if not ok then warn("[PompompurinAviso] error:", err) end
	screenGui:Destroy()
end)
