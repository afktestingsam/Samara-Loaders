local function Defer(fn) task.defer(function() pcall(fn) end) end
local function batchScan(container, callback, batchSize, yieldTime)
    batchSize = batchSize or 100
    yieldTime = yieldTime or 0.02
    local list = container:GetDescendants()
    local total = #list
    for i = 1, total, batchSize do
        local stop = math.min(i + batchSize - 1, total)
        for j = i, stop do pcall(callback, list[j]) end
        task.wait(yieldTime)
    end
end

