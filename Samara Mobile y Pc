local function hm(h, m) return h * 60 + (m or 0) end
local SEGMENTS = {
	{hm(0),      hm(1),      0,   0},
	{hm(1),      hm(7),      10,  10},
	{hm(7),      hm(15),     25,  25},
	{hm(15),     hm(16),     25,  99},
	{hm(16),     hm(17, 30), 99,  99},
	{hm(17, 30), hm(18, 30), 99,  100},
	{hm(18, 30), hm(24),     100, 100},
}

local function getMexicoTime()
	return os.date("!*t", os.time() + MX_UTC_OFFSET * 3600)
end

local function getPercent()
	local t = getMexicoTime()
	if MAINTENANCE_DATE then
		local today = string.format("%04d-%02d-%02d", t.year, t.month, t.day)
		if today < MAINTENANCE_DATE then return 0 end
		if today > MAINTENANCE_DATE then return 100 end
	end
	local minutes = t.hour * 60 + t.min + t.sec / 60
	for _, s in ipairs(SEGMENTS) do
		if minutes >= s[1] and minutes < s[2] then
			local alpha = (minutes - s[1]) / (s[2] - s[1])
			return s[3] + (s[4] - s[3]) * alpha
		end
	end
	return 100
end

